# --- Database (required) ---
# Local MySQL example:
DB_USER=root
DB_PASSWORD=change_me
DB_HOST=localhost
DB_PORT=3306
DB_NAME=question_paper_db

# Alternatively, use a single DATABASE_URL (takes precedence over the DB_* vars above):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/dbname
# DATABASE_URL=sqlite:///app.db


# --- AI providers (at least ONE required; chain runs in this priority order) ---

# 1. Google Gemini  -  https://aistudio.google.com/app/apikey  (free tier: ~15 RPM, 1M tokens/day)
GOOGLE_API_KEY=

# 2. Groq (Llama 3.3 70B, very fast)  -  https://console.groq.com/keys  (free tier: 30 RPM, 14.4k req/day)
GROQ_API_KEY=

# 3. OpenRouter (free DeepSeek/Llama models)  -  https://openrouter.ai/keys  (free tier varies by model)
OPENROUTER_API_KEY=


# --- Optional ---

# Set to "1" to expose /db-test and /debug-questions endpoints. Leave blank in production.
FLASK_DEBUG=

# Comma-separated allowed origins for /api/* CORS. Leave blank if the frontend is same-origin.
# CORS_ORIGINS=https://your-frontend.example.com
